NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=

# Alchemy premium key — portfolio, prices, and RPC. Server-only.
ALCHEMY_API_KEY=

# Alchemy Gas Manager policy id — sponsors gas for every supported EVM
# transaction via the EIP-7702 flow (see app/api/alchemy-bundler + lib/trade/base-sponsor).
# Create a Bundler Sponsored Operations policy in the Alchemy dashboard and
# enable the networks you want this app to cover.
# Server-only; without it sponsored sends fail and fall back to normal wallet gas.
ALCHEMY_GAS_POLICY_ID=
# The World Street API gateway — the ONE base URL every platform service hangs
# off at /v1/<service> (rwa, perp, chess, trade, earn, payment, gas-sponsor,
# prediction-market, world-street-vault). Leave unset to use production; set it
# to point the whole app at a local or staging gateway. The per-service vars
# further down are optional overrides for redirecting ONE service while the
# rest stay on this base — none of them is required any more.
# WSAPI_BASE_URL=https://api.worldstreetwebservices.com
# NEXT_PUBLIC_WSAPI_BASE_URL=   # only if client code must see a non-prod base

# Optional dedicated override for only the Solana gas sponsor route. Use this
# when the rest of the platform should stay on the shared deployed gateway but
# Solana sponsorship should hit a local or staging gas-sponsor service.
# GAS_SPONSOR_API_URL=http://127.0.0.1:8092

# Token-trading backend (memecoins). Derives from WSAPI_BASE_URL (/v1/trade);
# override only for a local or staging trade service.
# NEXT_PUBLIC_TRADE_API_URL=http://localhost:8084
# Alchemy Access Key with Gas Manager Read permission. Needed only for local
# policy inspection, for example `pnpm alchemy:policy-check`.
# The current Alchemy dashboard terminology is "Access Key" under Security.
ALCHEMY_ACCESS_KEY=
# Optional legacy alias accepted by the local checker.
ALCHEMY_GAS_MANAGER_ACCESS_KEY=
# Optional older alias accepted by the local checker.
ALCHEMY_ADMIN_ACCESS_TOKEN=

DEXTOPUS_API_KEY=

# LI.FI aggregator for EVM swaps (Base, Arbitrum, Polygon). Key from
# portal.li.fi. Kept server-side; requests proxy through /api/lifi.
LIFI_API_KEY=
# Optional swap fee in basis points (e.g. 25 = 0.25%). Requires fee-receiver
# wallets configured in the LI.FI portal. Unset or 0 means no WSWS fee.
LIFI_FEE_BPS=

# Polymarket prediction markets. Builder credentials from polymarket.com
# (Settings > Builders). SECRET and PASSPHRASE are server-only.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Builder code for on-chain trade attribution (public, embedded in signed orders).
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

# World Street (local) on-chain CPMM prediction market. The API derives from
# WSAPI_BASE_URL (/v1/prediction-market); set the override only for a local
# service. The contract address on Base is public.
# NEXT_PUBLIC_PREDICTION_API_URL=http://localhost:8085
NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=

# King of Night vault game (world-street-vault service). Public gateway
# endpoints, called directly from the client (the gateway handles CORS; no
# key needed for reads). wager()/claim() are signed client-side by the
# user's own wallet against this contract on Base, the backend never signs.
# Derives from WSAPI_BASE_URL (/v1/world-street-vault); override only for a
# local vault service.
# NEXT_PUBLIC_VAULT_API_URL=
# Single realtime hub at the root; subscribe to the topic vault:king-of-night.
NEXT_PUBLIC_VAULT_WS_URL=wss://ws.worldstreetwebservices.com/
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=0x103db9Ac546297371499AC571880065A59B8Ac38

# Vivid voice backend (apps/ai) — the browser opens its /audio WebSocket directly
# and authenticates with the user's Privy access token. Host only (path + token
# added in code). Dev: ws://localhost:8090
NEXT_PUBLIC_AI_WS_URL=

# Vivid text-to-speech (ElevenLabs) — Vivid's spoken replies stream through the
# server-side proxy at app/api/tts, so the key never reaches the browser.
# Required for Vivid to speak; without it the assistant still runs but stays
# silent. Get the key from elevenlabs.io (Profile > API key). Server-only secret.
ELEVENLABS_API_KEY=
# Voice + model are optional overrides. Defaults: "George" (UK) on eleven_flash_v2_5
# (low-latency). Pick another voice id from the ElevenLabs voice library.
ELEVENLABS_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional: set to "1" to print the [vivid] voice pipeline debug logs in the
# browser console (capture -> wake-word -> send -> frames -> speak). On in dev by
# default, off in production. Set "0" to force off.
# NEXT_PUBLIC_VOICE_DEBUG=

# Chess service on the platform gateway. Reads (lobby, board, moves, PGN) are
# public; writes go through app/api/chess, which verifies the caller's Privy
# session and names them by the wallet that session owns. Derives from
# WSAPI_BASE_URL (/v1/chess); CHESS_API_URL overrides for a local service.
# Dev: http://127.0.0.1:18083
# CHESS_API_URL=http://127.0.0.1:18083
# NEXT_PUBLIC_CHESS_API_URL=
NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=0x09F05Bdfb3cFA9125f253b8E3d7814cC5Beca3D0

# Gas-sponsor service: native Solana fee sponsorship. Derives from
# WSAPI_BASE_URL (/v1/gas-sponsor); override only for a local sponsor service.
# GAS_SPONSOR_API_URL=http://localhost:8092
# In-house sponsorship: when set, this server rewrites the fee payer and signs
# with this key itself and the gas-sponsor service is not called at all.
# Accepts a base58 secret key (Phantom export) or a JSON byte array
# (solana-keygen). Fund the wallet with SOL; it pays every sponsored fee.
# SOLANA_PRIVATE_KEY=

# Casino gateway for the draw and spectator betting. Unset means those screens
# show their "not available yet" state; chess does not use these.
# NEXT_PUBLIC_CASINO_API_URL=
# CASINO_API_KEY=

# Perp gateway (Avantis on Base). Unset falls back to the shared WSAPI base;
# the WS feed streams Pyth marks and degrades to REST polling when absent.
# PERP_API_BASE_URL=
# NEXT_PUBLIC_PERP_WS_URL=wss://ws.worldstreetwebservices.com

# Earn service: bounty listings, sponsors, submissions. Derives from
# WSAPI_BASE_URL (/v1/earn); override only for a local earn service
# (dev: http://localhost:8083). Server-only: reached through app/api/earn.
# EARN_API_URL=http://localhost:8083
# EARN_API_KEY=

# The earn screens read live data. Set this to 1 to fall back to built-in sample
# listings instead, which is worth doing if the earn service goes down: it lost
# its database for a day and every query endpoint answered 500.
# NEXT_PUBLIC_EARN_FIXTURES=1

# Realtime gateway. One socket serves every game: subscribe to a topic such as
# vault:king-of-night, or a chess match's own liveTopic. Falls back to
# NEXT_PUBLIC_VAULT_WS_URL, which named the same gateway before chess used it.
# NEXT_PUBLIC_WS_GATEWAY_URL=wss://ws.worldstreetwebservices.com/

# Soft takedown. NEXT_PUBLIC_APP_ACTIVE=false keeps the site up but turns every
# landing CTA into a coming-soon notice; ALLOW_ACCESS=false additionally
# redirects any directly typed route (e.g. /dashboard) back to the landing page
# (see proxy.ts). Unset means fully live. Both are read at build/deploy time —
# flipping them on Vercel needs a redeploy to take effect.
# NEXT_PUBLIC_APP_ACTIVE=false
# ALLOW_ACCESS=false
