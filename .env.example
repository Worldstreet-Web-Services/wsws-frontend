NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=

# Decane Connect Kit, the auth and embedded-wallet provider replacing Privy.
# The app id is public and used on both the client and the server; the API key
# is the publishable social-mode key from the Decane dashboard. Server-side
# token verification uses Decane's JWKS and needs no secret. Optionally set
# DECANE_VERIFICATION_KEY (the project's ES256 public key, PEM) to verify
# offline instead.
NEXT_PUBLIC_DECANE_APP_ID=
NEXT_PUBLIC_DECANE_API_KEY=
# DECANE_VERIFICATION_KEY=

# Server-only country lookup used by local Chess tournament joins. Production
# prefers trusted edge country headers when they are present.
IPINFO_TOKEN=

ALCHEMY_API_KEY=
# Second Alchemy key, tried when the first is rate limited (429), rejected
# (401/403) or failing (5xx). Optional: leave it blank to run on one key.
# Every indexed Portfolio/Prices call rotates through the pair, so a throttled
# key stops being an outage. It is never used for sponsorship because a policy
# belongs to the Alchemy account of the primary key.
ALCHEMY_API_KEY_FALLBACK=
# Dedicated policy-owning Alchemy key. This keeps Portfolio/Prices credentials
# independent. When unset, sponsorship falls back to ALCHEMY_API_KEY for
# compatibility, but never to ALCHEMY_API_KEY_FALLBACK.
ALCHEMY_GAS_MANAGER_API_KEY=
# Alchemy Gas Manager policies. The sponsorship key must belong to the same
# Alchemy account as these policies. Base uses Bundler Sponsored Operations;
# Polygon uses the standard paymaster flow.
ALCHEMY_GAS_POLICY_ID=
ALCHEMY_POLYGON_GAS_POLICY_ID=
# Server-only Solana mainnet RPC pool. The fallback is tried when the primary
# Helius project is throttled or unavailable. Never expose these as NEXT_PUBLIC_*.
HELIUS_API_KEY=
HELIUS_API_KEY_FALLBACK=
# Optional provider-neutral Solana RPC override. A legacy Alchemy URL remains
# available as fallback behind Helius; any other explicit provider stays first.
SOLANA_RPC_URL=

# Server-only ZeroDev project id. One project derives the EVM read RPC URL for
# every supported chain. Bundler/paymaster submission remains on Alchemy. Keep
# this out of NEXT_PUBLIC_* variables.
ZERODEV_PROJECT_ID=

DEXTOPUS_API_KEY=

DEXTOPUS_WITHDRAW_API_KEY=
# Everything else that moves money through Dextopus (spot buys and sells, the
# buy catalog, gas top-ups, the casino fund sheet, prediction settlement) is a
# Optional dedicated third integration. When omitted, trade routes fall back
# to DEXTOPUS_API_KEY for compatibility with existing environments.
DEXTOPUS_TRADE_API_KEY=

LIFI_API_KEY=

POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Builder code for on-chain trade attribution (public, embedded in signed orders).
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=

NEXT_PUBLIC_VAULT_WS_URL=wss://ws.worldstreetwebservices.com/
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=0x103db9Ac546297371499AC571880065A59B8Ac38

NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=0x09F05Bdfb3cFA9125f253b8E3d7814cC5Beca3D0

NEXT_PUBLIC_MIXPANEL_TOKEN=

# Microsoft Clarity project id. Unset means lib/analytics/clarity.ts is a
# no-op, so no session is recorded.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# The launch gate (lib/launch-gate.ts). Before this moment the landing page
# shows a countdown and every other route redirects home; from it the site is
# live, no redeploy needed. ISO with offset. Unset means no scheduled launch.
NEXT_PUBLIC_LAUNCH_AT=2026-08-16T20:00:00+01:00

# Market Square — the ecosystem social surface. Unset hides its nav entry
# rather than rendering a link that goes nowhere.
NEXT_PUBLIC_MARKET_SQUARE_URL=
