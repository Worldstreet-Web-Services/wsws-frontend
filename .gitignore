# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
git.txt
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling and vendored skills (keep only the tracked engineering standards)
.agents/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/wsws-engineering-standards/

# Design handoff reference bundles (not shipped)
design_handoff_*/

# One-shot helper scripts handed to the developer, never part of the tree.
# Root level only, so scripts/ is unaffected.
/*.sh

# Screen recordings shared for debugging, never part of the tree.
*.mov
