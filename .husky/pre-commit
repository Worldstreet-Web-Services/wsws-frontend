# Fast gate. Formats and lints ONLY the files being committed, so a commit
# costs seconds. The slow checks live in pre-push, and the authoritative run is
# the `quality` job in CI, which main's branch protection requires.
export PATH="$HOME/.nvm/versions/node/v22.23.0/bin:$HOME/.nvm/versions/node/v22.23.0/lib/node_modules/corepack/shims:$HOME/.local/share/mise/shims:$HOME/.local/share/mise/installs/node/20.20.2/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

pnpm exec lint-staged
