NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=

# Alchemy premium key — portfolio, prices, and RPC. Server-only.
ALCHEMY_API_KEY=

DEXTOPUS_API_KEY=

# LI.FI aggregator for EVM swaps (Base, Arbitrum, Polygon). Key from
# portal.li.fi. Kept server-side; requests proxy through /api/lifi.
LIFI_API_KEY=
# Optional swap fee in basis points (e.g. 25 = 0.25%). Requires fee-receiver
# wallets configured in the LI.FI portal. Unset or 0 means no WSWS fee.
LIFI_FEE_BPS=

# Polymarket prediction markets. Builder credentials from polymarket.com
# (Settings > Builders). SECRET and PASSPHRASE are server-only.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Builder code for on-chain trade attribution (public, embedded in signed orders).
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

# King of Night vault game (world-street-vault service). Public gateway
# endpoints, called directly from the client (the gateway handles CORS; no
# key needed for reads). wager()/claim() are signed client-side by the
# user's own wallet against this contract on Base, the backend never signs.
NEXT_PUBLIC_VAULT_API_URL=https://api.worldstreetwebservices.com/v1/world-street-vault
# Single realtime hub at the root; subscribe to the topic vault:king-of-night.
NEXT_PUBLIC_VAULT_WS_URL=wss://ws.worldstreetwebservices.com/
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=0x103db9Ac546297371499AC571880065A59B8Ac38
